# Names only. Never put real values in this file or in git.
# Set real values in the hosting dashboard (Railway → service → Variables).

# Required in production: long random passphrase (16+ characters) for first setup and password reset.
SETUP_CODE=
# Optional AI provider keys (can also be pasted in Settings → AI engines).
KEY_OPENAI=
KEY_GEMINI=
KEY_PERPLEXITY=
KEY_ANTHROPIC=
# Persistent folder for the database and backups.
DATA_DIR=/data
# Optional: how many days a sign-in lasts (1-90, default 14).
SESSION_DAYS=
# Optional: end every sign-in made before this date/time, e.g. 2026-10-22T12:00:00Z.
REVOKE_SESSIONS_BEFORE=
# Optional: API requests per minute per address (default 600).
API_RATE_LIMIT_PER_MIN=
# Optional: extra website addresses allowed to call the API from a browser (comma separated).
ALLOWED_ORIGINS=
