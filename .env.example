# Server-side values for the deploy and test scripts. Copy to .env and fill in; never commit .env or paste values in chat.
# Ask a Housedge admin for them. The app itself does not read this file: function secrets are set in Supabase.

# Supabase personal access token (supabase.com → Account → Access Tokens). Full access to the account: keep it safe.
SUPABASE_ACCESS_TOKEN=
# The project reference (the part before .supabase.co).
SUPABASE_PROJECT_REF=
SUPABASE_URL=https://<project-ref>.supabase.co
# Public key (same as VITE_SUPABASE_PUBLISHABLE_KEY in web/.env.local).
SUPABASE_PUBLISHABLE_KEY=
# No Claude key here: the app reads it from the Supabase function secret ANTHROPIC_API_KEY.
# First-setup code (16+ characters), only used by the tests and when creating the first admin on a fresh project.
HOUSEDGE_SETUP_CODE=
